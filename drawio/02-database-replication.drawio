  <diagram name="Database Replication" id="db-replication">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="PostgreSQL Streaming Replication Architecture (v1.3.0)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="30" width="800" height="50" as="geometry" />
        </mxCell>
        
        <!-- Primary Database -->
        <mxCell id="primary" value="&lt;b&gt;PostgreSQL Primary&lt;/b&gt;&#xa;postgres-primary:5432&#xa;&#xa;✓ Write Operations&#xa;✓ Read Operations&#xa;✓ WAL Generation&#xa;✓ Streaming to Replicas&#xa;&#xa;Config:&#xa;max_wal_senders = 10&#xa;wal_level = replica&#xa;hot_standby = on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="150" width="300" height="220" as="geometry" />
        </mxCell>
        
        <!-- Replica 1 -->
        <mxCell id="replica1" value="&lt;b&gt;PostgreSQL Replica 1&lt;/b&gt;&#xa;postgres-replica1:5433&#xa;&#xa;✓ Read-Only Operations&#xa;✓ Hot Standby Mode&#xa;✓ WAL Receiver Active&#xa;✓ Promotion Ready&#xa;&#xa;Status:&#xa;Recovery Mode: TRUE&#xa;Replication Lag: &lt; 1s&#xa;State: STREAMING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=11;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="480" width="280" height="220" as="geometry" />
        </mxCell>
        
        <!-- Replica 2 -->
        <mxCell id="replica2" value="&lt;b&gt;PostgreSQL Replica 2&lt;/b&gt;&#xa;postgres-replica2:5434&#xa;&#xa;✓ Read-Only Operations&#xa;✓ Hot Standby Mode&#xa;✓ WAL Receiver Active&#xa;✓ Promotion Ready&#xa;&#xa;Status:&#xa;Recovery Mode: TRUE&#xa;Replication Lag: &lt; 1s&#xa;State: STREAMING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=11;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1020" y="480" width="280" height="220" as="geometry" />
        </mxCell>
        
        <!-- WAL Streaming Arrows -->
        <mxCell id="wal-to-replica1" value="WAL Streaming&#xa;(Asynchronous)&#xa;Port 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=4;strokeColor=#9673a6;fontSize=12;fontStyle=1" edge="1" parent="1" source="primary" target="replica1">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="wal-to-replica2" value="WAL Streaming&#xa;(Asynchronous)&#xa;Port 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=4;strokeColor=#9673a6;fontSize=12;fontStyle=1" edge="1" parent="1" source="primary" target="replica2">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- FastAPI Read Connection -->
        <mxCell id="fastapi-read" value="&lt;b&gt;FastAPI Application&lt;/b&gt;&#xa;get_read_db()&#xa;&#xa;Read Operations&#xa;Load Balancing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="800" width="200" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="read-arrow1" value="SELECT Queries&#xa;(Load Balanced)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;strokeWidth=3;strokeColor=#6c8ebf;dashed=1;fontSize=11;fontStyle=1" edge="1" parent="1" source="fastapi-read" target="replica1">
          <mxGeometry x="-0.2" relative="1" as="geometry">
