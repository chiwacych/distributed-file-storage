          <mxGeometry x="400" y="840" width="320" height="40" as="geometry" />
        </mxCell>
        
        <!-- FastAPI Write Connection -->
        <mxCell id="fastapi-write" value="&lt;b&gt;FastAPI Application&lt;/b&gt;&#xa;get_write_db()&#xa;&#xa;Write Operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="800" width="200" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="write-arrow" value="INSERT/UPDATE/DELETE&#xa;(Primary Only)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;strokeWidth=3;strokeColor=#d6b656;fontSize=11;fontStyle=1" edge="1" parent="1" source="fastapi-write" target="replica2">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1180" y="750" />
              <mxPoint x="850" y="750" />
              <mxPoint x="850" y="400" />
              <mxPoint x="700" y="400" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Metrics Box -->
        <mxCell id="metrics" value="&lt;b&gt;📊 Replication Metrics&lt;/b&gt;&#xa;&#xa;• Type: Asynchronous Streaming&#xa;• Lag: &lt; 1 second typical&#xa;• RTO: 30 seconds (manual failover)&#xa;• RPO: &lt; 1 second (data loss)&#xa;• Active Replicas: 2&#xa;• State: STREAMING&#xa;• WAL Senders: 2/10 used&#xa;• Protocol: Physical Replication&#xa;&#xa;Monitoring Commands:&#xa;SELECT * FROM pg_stat_replication;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;fontSize=11;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="970" width="380" height="100" as="geometry" />
        </mxCell>
        
        <!-- Failover Note -->
        <mxCell id="failover" value="&lt;b&gt;⚠️ Failover Process&lt;/b&gt;&#xa;&#xa;&lt;b&gt;Steps:&lt;/b&gt;&#xa;1. Primary database fails&#xa;2. Promote replica to primary:&#xa;   pg_ctl promote -D /data&#xa;3. Update app DATABASE_URL&#xa;4. Restart FastAPI application&#xa;5. Verify write operations&#xa;&#xa;&lt;b&gt;Metrics:&lt;/b&gt;&#xa;• Write Downtime: ~30 seconds&#xa;• Read Availability: 100%&#xa;• Potential Data Loss: &lt; 1s&#xa;• Recovery Point: Last WAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;fontSize=11;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="800" width="380" height="270" as="geometry" />
        </mxCell>
        
        <!-- Replication Flow Labels -->
        <mxCell id="flow-label1" value="Continuous WAL Streaming" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="320" y="400" width="160" height="20" as="geometry" />
